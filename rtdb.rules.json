{
  "rules": {
    "serverTimeCheck": {
      "$restaurantId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.child('time').val() === now"
      }
    },
    "tvLease": {
      "$restaurantId": {
        "$screenId": {
          ".read": true,
          ".write": "!data.exists() || !newData.exists() || data.child('deviceId').val() === newData.child('deviceId').val()",
          ".validate": "newData.hasChildren(['deviceId', 'claimedAt']) && newData.child('deviceId').isString() && newData.child('claimedAt').isNumber()"
        }
      }
    },
    "tvEvents": {
      "$restaurantId": {
        ".indexOn": ["at"],
        ".read": "auth != null && auth.token.admin === true",
        "$eventId": {
          ".write": "!data.exists() || (auth != null && auth.token.admin === true)",
          ".validate": "newData.hasChildren(['type', 'deviceId', 'screenId', 'at']) && newData.child('at').val() === now && newData.child('deviceId').isString() && newData.child('screenId').isString() && (newData.child('type').val() === 'claim' || newData.child('type').val() === 'blocked' || newData.child('type').val() === 'takeover') && (newData.child('type').val() === 'blocked' || newData.child('deviceId').val() === root.child('tvLease').child($restaurantId).child(newData.child('screenId').val()).child('deviceId').val())"
        }
      }
    },
    "subscription": {
      "$restaurantId": {
        "expiresAt": {
          ".read": "!data.exists() || now < data.val()",
          ".write": "auth != null && auth.token.admin === true"
        }
      }
    },
    "logs": {
      "$entryId": {
        ".read": false,
        ".write": true,
        ".validate": "newData.hasChildren(['message', 'ts']) && newData.child('message').isString() && newData.child('ts').isNumber()"
      }
    }
  }
}
